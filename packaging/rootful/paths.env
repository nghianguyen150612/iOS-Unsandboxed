# P001 rootful path contract. This file documents constants for a future
# installer; P001 does not source it or install files onto a device.
IOS_UNSANDBOXED_CLI=/usr/local/bin/ios-unsandboxed
IOS_UNSANDBOXED_ALIAS=/usr/local/bin/iu
IOS_UNSANDBOXED_DAEMON=/usr/local/bin/ios-unsandboxedd
IOS_UNSANDBOXED_MANAGER=/var/lib/ios-unsandboxed/manager.sh
IOS_UNSANDBOXED_STATE=/var/lib/ios-unsandboxed/install-state
IOS_UNSANDBOXED_EXECUTION_POLICY=/var/lib/ios-unsandboxed/execution-policy
IOS_UNSANDBOXED_INSTALL_MANIFEST=/var/lib/ios-unsandboxed/install-manifest
IOS_UNSANDBOXED_DATA_DIR=/var/lib/ios-unsandboxed
IOS_UNSANDBOXED_BACKUP_DIR=/var/lib/ios-unsandboxed/backups
IOS_UNSANDBOXED_STAGING_DIR=/var/lib/ios-unsandboxed/staging
IOS_UNSANDBOXED_NATIVE_DIR=/usr/local/lib/ios-unsandboxed
IOS_UNSANDBOXED_LAUNCHD_PLIST=/Library/LaunchDaemons/com.ios-unsandboxed.daemon.plist
IOS_UNSANDBOXED_INACTIVE_PLIST=/var/lib/ios-unsandboxed/com.ios-unsandboxed.daemon.plist.inactive
IOS_UNSANDBOXED_SOCKET=/var/run/ios-unsandboxedd.sock
IOS_UNSANDBOXED_LOG_DIR=/var/log/ios-unsandboxed
