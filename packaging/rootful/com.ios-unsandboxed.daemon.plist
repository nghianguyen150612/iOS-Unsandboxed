<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ios-unsandboxed.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/ios-unsandboxedd</string>
		<string>--serve</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>GroupName</key>
	<string>wheel</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/var/log/ios-unsandboxed/daemon.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/ios-unsandboxed/daemon.stderr.log</string>
</dict>
</plist>
